{
  "name": "problem-explorer-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace Diagnostics Engine — reusable diagnostics platform",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r run build",
    "build:engine": "pnpm --filter @pe/* run build",
    "test": "pnpm -r run test",
    "test:engine": "pnpm --filter @pe/* run test",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"packages/**/*.ts\"",
    "clean": "pnpm -r run clean",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}