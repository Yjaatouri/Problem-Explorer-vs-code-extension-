{
  "name": "@pe/provider-vscode-realtime",
  "description": "Realtime diagnostics provider: forwards editor diagnostics (VS Code) into the engine as a provider-owned source.",
  "version": "1.0.0",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
